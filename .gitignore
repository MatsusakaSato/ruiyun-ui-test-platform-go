# 构建产物（不要提交）
*.test
*.out
/ruiyun-autotest
/ruiyun-cli
/bin/
/dist/
coverage.out
coverage.html

# 运行期数据（默认落在用户目录，此处兜底）
/rounds/
/logs/
/artifacts/
*.db
*.db-wal
*.db-shm
# 应用设置覆盖文件：POST /api/app-settings 会写它，内容是运行期状态（带 saved_at），
# 不是源码，不应提交。
.app_settings.json

# 本机密钥：大模型 Key、钉钉群机器人 Token/加签。都带 0600，
# 默认落在工作区，但 settings.go 兼容「旧的仓库根目录位置」并会自动迁移，
# 所以仓库根目录也一并忽略 —— 一旦误提交就是泄露真实 Token。
.llm_secrets.json
.notify_secrets.json

# 助手（WorkBuddy）的项目记忆与配置目录
.workbuddy/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
.gocache/

# 前端冒烟测试用的 node_modules 软链（依赖在 workspace 外，不入库）
node_modules
